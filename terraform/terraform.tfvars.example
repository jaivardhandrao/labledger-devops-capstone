# NOT a ready-to-apply authorization. Copy to gitignored terraform.tfvars locally.
# Replace DOCUMENTATION-ONLY addresses with the actual approved operator egress.
approved_account_id       = "000000000000" # DOCUMENTATION ONLY; replace approved sandbox ID.
aws_region                = "ap-south-1"
availability_zones        = ["ap-south-1a", "ap-south-1b"]
cluster_name              = "labledger-capstone"
kubernetes_version        = "1.34" # Verify standard-support availability first.
api_allowed_cidrs         = ["203.0.113.10/32"] # RFC 5737 documentation address ONLY.
enable_nat_gateway        = true # Proposed private-node mode; adds NAT + EIP charges.
node_instance_type        = "t3.large"
node_min_size             = 1
node_desired_size         = 1
node_max_size             = 1
operator_principal_arn    = null # Set the exact approved IAM role/user ARN.
grant_bootstrap_cluster_admin = false # Privileged opt-in needs separate approval.
ingress_client_cidrs      = [] # Approved app audience; never used for the API.
# NO AWS keys, tokens, account passwords, or database credentials belong here.
